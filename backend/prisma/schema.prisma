generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelos de la base de datos

// Relacion 1:N, un usuario puede tener muchos agendamientos, pero un agendamiento solo puede tener un usuario
model Usuario {
    rut_usuario String @id
    correo String? @db.VarChar(100) //el "?" indica que es opcional
    telefono String? @db.VarChar(15)
    fecha_nacimiento DateTime?
    contrasena String @db.VarChar(100)
    agendamientos  Agendamiento[] //el "Muchos" de la relacion
    insumos        Insumo[] //el "Muchos" de la relacion
    turnos        Turno[] //el "Muchos" de la relacion

}

model Agendamiento {
    id Int @id @default(autoincrement())
    fecha DateTime
    hora_inicio DateTime
    hora_fin DateTime
    rut_usuario String
    usuario Usuario @relation(fields: [rut_usuario], references: [rut_usuario]) //Establecer la FK 
}

// Relacion 1:N, un usuario puede registrar muchos insumos, pero un insumo solo puede ser registrado por un usuario
model Insumo{
  id Int @id @default(autoincrement())
  tipo_insumo String @db.VarChar(100)
  fecha_ingreso DateTime
  fecha_vencimiento DateTime?
  descripcion String? @db.VarChar(255)
  cantidad Int
  rut_usuario String
  usuario Usuario @relation(fields: [rut_usuario], references: [rut_usuario])
}

// Relacion N:N, un usuario puede tener muchos horarios, y un horario puede ser compartido por muchos usuarios
model Horario{
  id Int @id @default(autoincrement())
  fecha DateTime
  turnos Turno[] //el "Muchos" de la relacion

}

model Turno {
  rut_usuario String
  horario_id Int
  usuario Usuario @relation(fields: [rut_usuario], references: [rut_usuario])
  horario Horario @relation(fields: [horario_id], references: [id])

  @@id([rut_usuario, horario_id]) //Clave primaria compuesta
}
