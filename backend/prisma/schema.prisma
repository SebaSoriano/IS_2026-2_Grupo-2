generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelos de la base de datos

// Relacion 1:N, un usuario puede tener muchos agendamientos, pero un agendamiento solo puede tener un usuario
model Usuario {
    rut_usuario String @id
    nombre_usuario String
    correo String? @db.VarChar(100) //el "?" indica que es opcional
    telefono String? @db.VarChar(15)
    fecha_nacimiento DateTime?
    contrasena String @db.VarChar(100)
    agendamientos  Agendamiento[] //el "Muchos" de la relacion
    insumos        Insumo[] //el "Muchos" de la relacion
    turnos        Turno[] //el "Muchos" de la relacion
    donaciones    donaciones[] //el "Muchos" de la relacion
    adopciones  adopciones[]
    rol_id Int
    rol Rol @relation(fields: [rol_id], references: [id])
}

model Agendamiento {
    id Int @id @default(autoincrement())
    fecha DateTime
    hora_inicio DateTime
    hora_fin DateTime
    rut_usuario String
    usuario Usuario @relation(fields: [rut_usuario], references: [rut_usuario]) //Establecer la FK 
}

// Relacion 1:N, un usuario puede registrar muchos insumos, pero un insumo solo puede ser registrado por un usuario
model Insumo{
  id Int @id @default(autoincrement())
  tipo_insumo String @db.VarChar(100)
  fecha_ingreso DateTime
  fecha_vencimiento DateTime?
  descripcion String? @db.VarChar(255)
  cantidad Int
  rut_usuario String
  usuario Usuario @relation(fields: [rut_usuario], references: [rut_usuario])
}


// Relacion N:N, un usuario puede tener muchos horarios, y un horario puede ser compartido por muchos usuarios
// Horario estatico con los dias de la semana: el id identifica el dia (1 = Lunes ... 7 = Domingo)
model Horario{
  id Int @id
  dia String @unique @db.VarChar(20)
  turnos Turno[] //el "Muchos" de la relacion

}

// Un usuario puede tener varios turnos en un mismo dia
// hora_inicio es el bloque de una hora en que llega (ej: "08:00")
// hora_fin es la hora en que se va, es opcional (si no viene, el turno dura solo ese bloque)
model Turno {
  id Int @id @default(autoincrement())
  rut_usuario String
  horario_id Int
  hora_inicio String @db.VarChar(5)
  hora_fin String? @db.VarChar(5)
  usuario Usuario @relation(fields: [rut_usuario], references: [rut_usuario])
  horario Horario @relation(fields: [horario_id], references: [id])

  @@unique([rut_usuario, horario_id, hora_inicio]) //el mismo usuario no puede repetir el bloque en el mismo dia
}

model historial_medico {
  id_historial      Int       @id @default(autoincrement())
  nombre            String?   @db.VarChar(100)
  tratamiento       String    @db.VarChar(500)
  fecha_tratamiento DateTime
  veterinario       String    @db.VarChar(100)
  observaciones     String?   @db.VarChar(500)

  id_animal Int
  animal    animales @relation(fields: [id_animal], references: [id_animal])
}

model animales {
  id_animal             Int               @id @default(autoincrement())
  nombre_animal        String            @db.VarChar(100) 
  edad                  Int
  via_ingreso           String            @db.VarChar(100)
  peso_animal           Float
  especie_animal        String            @db.VarChar(100)
  observaciones_animal  String?

  historial historial_medico[]
  adopciones adopciones[]
}

model donaciones {
  id_donacion Int @id @default(autoincrement())
  tipo_donacion String @db.VarChar(100)
  monto_donacion Int?
  fecha_donacion DateTime
  
  rut_usuario String 
  usuario Usuario @relation(fields: [rut_usuario], references: [rut_usuario])
}

model adoptante {
  id_adoptante              Int         @id @default(autoincrement())
  direccion                 String
  telefono                  String
  correo                    String
  fecha_nacimiento          DateTime
  observaciones_adoptante   String?
  adopciones adopciones[]
}

model adopciones {
  fecha_adopcion DateTime

  id_usuario String
  usuario Usuario @relation(fields: [id_usuario], references: [rut_usuario])

  id_animal Int
  animal animales @relation(fields: [id_animal], references:[id_animal])

  id_adoptante Int
  adoptante adoptante @relation(fields: [id_adoptante], references: [id_adoptante])

  @@id([id_usuario, id_animal, id_adoptante])
}

model Rol {
  id Int @id
  nombre String @unique @db.VarChar(50)
  usuarios Usuario []
}