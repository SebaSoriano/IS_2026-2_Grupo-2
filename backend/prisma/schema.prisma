generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelos de la base de datos

// Relacion 1:N, un usuario puede tener muchos agendamientos, pero un agendamiento solo puede tener un usuario
model Usuario {
  rut_usuario        String                 @id
  nombre_usuario     String
  correo             String?                @db.VarChar(100) //el "?" indica que es opcional
  telefono           String?                @db.VarChar(15)
  fecha_nacimiento   DateTime?
  contrasena         String                 @db.VarChar(100)
  agendamientos      Agendamiento[] //el "Muchos" de la relacion
  insumos            Insumo[] //el "Muchos" de la relacion
  turnos             Turno[] //el "Muchos" de la relacion
  donaciones         donaciones[] //el "Muchos" de la relacion
  adopciones         adopciones[]
  rol_id             Int
  rol                Rol                    @relation(fields: [rol_id], references: [id])
  cuentas            cuenta_transferencia[]
  movimientos_insumo movimiento_insumo[] //movimientos del inventario que registró este usuario
  consumos_diarios   consumo_diario[]
}

model Agendamiento {
  id          Int      @id @default(autoincrement())
  fecha       DateTime
  hora_inicio DateTime
  hora_fin    DateTime
  rut_usuario String
  usuario     Usuario  @relation(fields: [rut_usuario], references: [rut_usuario]) //Establecer la FK 
}

// Relacion 1:N, un usuario puede registrar muchos insumos, pero un insumo solo puede ser registrado por un usuario
model Insumo {
  id                Int                 @id @default(autoincrement())
  tipo_insumo       String              @db.VarChar(100)
  marca             String?             @db.VarChar(100)
  fecha_ingreso     DateTime
  fecha_vencimiento DateTime?
  descripcion       String?             @db.VarChar(255)
  cantidad          Int
  unidad_medida     String              @default("unidad") @db.VarChar(10)
  // contable: el procedimiento descuenta la cantidad que usó (gasas, jeringas)
  // estado: no se mide cuánto se usa, solo el estado del envase (frascos, bidones)
  tipo_control      TipoControl         @default(contable)
  // solo para los de tipo "estado" (en los contables queda null):
  // cerrado -> abierto (primer uso en un procedimiento) -> se termina (botón "Se terminó")
  estado_envase     EstadoEnvase?
  fecha_apertura    DateTime? //cuándo se abrió el envase que está en uso
  rut_usuario       String
  usuario           Usuario             @relation(fields: [rut_usuario], references: [rut_usuario])
  id_donacion       Int?
  donacion          donaciones?         @relation(fields: [id_donacion], references: [id_donacion])
  historial         historial_insumo[] //registros médicos en los que se usó este insumo
  consumos_diarios  consumo_diario_insumo[]
  movimientos       movimiento_insumo[] //salidas y devoluciones de este insumo
}

// Relacion 1:N, un dia de la semana agrupa muchos turnos, y cada turno pertenece a un solo dia
// Dias de la semana: el id identifica el dia (1 = Lunes ... 7 = Domingo)
// en la base la tabla se sigue llamando "Horario"
model DiaSemana {
  id     Int     @id
  dia    String  @unique @db.VarChar(20)
  turnos Turno[] //el "Muchos" de la relacion

  @@map("Horario")
}

// Un turno es de una fecha puntual: el voluntario se anota para ese dia, no se repite cada semana
// Un usuario puede tener varios turnos en un mismo dia
// dia_semana_id es el dia de la semana de la fecha (lo calcula el backend), sirve para agrupar en el horario semanal
// hora_inicio es el bloque de una hora en que llega (ej: "08:00")
// hora_fin es la hora en que se va, es opcional (si no viene, el turno dura solo ese bloque)
// hora_llegada es la hora ("HH:MM") en que la persona apreto "Llegué"; null si aun no registra su llegada
// si llego a la hora, tarde o no vino se calcula con hora_llegada (ver estadoAsistencia en turno.service.js)
model Turno {
  id            Int       @id @default(autoincrement())
  rut_usuario   String
  fecha         DateTime  @db.Date //solo el dia, sin hora
  dia_semana_id Int       @map("horario_id") //en la base la columna se sigue llamando horario_id
  hora_inicio   String    @db.VarChar(5)
  hora_fin      String?   @db.VarChar(5)
  hora_llegada  String?   @db.VarChar(5)
  usuario       Usuario   @relation(fields: [rut_usuario], references: [rut_usuario])
  dia_semana    DiaSemana @relation(fields: [dia_semana_id], references: [id])

  @@unique([rut_usuario, fecha, hora_inicio]) //el mismo usuario no puede repetir el bloque en la misma fecha
}

model historial_medico {
  id_historial      Int      @id @default(autoincrement())
  nombre            String?  @db.VarChar(100)
  tratamiento       String   @db.VarChar(500)
  fecha_tratamiento DateTime
  veterinario       String   @db.VarChar(100)
  observaciones     String?  @db.VarChar(500)

  id_animal Int
  animal    animales @relation(fields: [id_animal], references: [id_animal])

  insumos     historial_insumo[] //insumos usados en este tratamiento, con su cantidad
  movimientos movimiento_insumo[] //movimientos del inventario que generó este registro
}

// Un envío diario agrupa los insumos usados en una jornada y quién lo registró.
model consumo_diario {
  id_consumo_diario Int      @id @default(autoincrement())
  fecha             DateTime @default(now())
  rut_usuario       String

  usuario     Usuario                 @relation(fields: [rut_usuario], references: [rut_usuario], onDelete: Restrict)
  insumos     consumo_diario_insumo[]
  movimientos movimiento_insumo[]
}

// Detalle de los insumos incluidos en un consumo diario.
// cantidad queda en null para insumos controlados por estado de envase.
model consumo_diario_insumo {
  id_consumo_diario Int
  id_insumo         Int
  cantidad          Int?

  consumo_diario consumo_diario @relation(fields: [id_consumo_diario], references: [id_consumo_diario], onDelete: Cascade)
  insumo         Insumo         @relation(fields: [id_insumo], references: [id], onDelete: Restrict)

  @@id([id_consumo_diario, id_insumo])
}

// Catálogo de procedimientos médicos comunes (vacunas, controles, cirugías, etc.).
// El formulario del historial médico los sugiere mientras se escribe el tipo de tratamiento.
model procedimiento {
  id_procedimiento Int    @id @default(autoincrement())
  nombre           String @unique @db.VarChar(100)
}

// Relacion N:N entre historial_medico e Insumo
model historial_insumo {
  id_historial Int
  id_insumo    Int
  // cuanto se uso; queda en null si el insumo es de tipo "estado" (solo se registra que se uso)
  cantidad     Int?

  historial historial_medico @relation(fields: [id_historial], references: [id_historial], onDelete: Cascade)
  insumo    Insumo           @relation(fields: [id_insumo], references: [id], onDelete: Restrict)

  @@id([id_historial, id_insumo])
}

// Como se controla el stock de un insumo
enum TipoControl {
  contable
  estado
}

// Estado del envase que esta en uso de un insumo de tipo "estado"
enum EstadoEnvase {
  cerrado
  abierto
  terminado
}

// salida: el insumo salio del inventario (se uso en un tratamiento)
// devolucion: el insumo volvio al inventario (se corrigio o se elimino el registro medico)
enum TipoMovimiento {
  salida
  devolucion
}

// Registro de movimientos del inventario
model movimiento_insumo {
  id_movimiento Int            @id @default(autoincrement())
  tipo          TipoMovimiento
  cantidad      Int
  fecha         DateTime       @default(now())
  descripcion   String         @db.VarChar(255)

  id_insumo    Int
  insumo       Insumo            @relation(fields: [id_insumo], references: [id], onDelete: Cascade)
  rut_usuario  String
  usuario      Usuario           @relation(fields: [rut_usuario], references: [rut_usuario])
  id_historial Int?
  historial    historial_medico? @relation(fields: [id_historial], references: [id_historial], onDelete: SetNull)
  id_consumo_diario Int?
  consumo_diario    consumo_diario? @relation(fields: [id_consumo_diario], references: [id_consumo_diario], onDelete: SetNull)
}

model animales {
  id_animal            Int          @id @default(autoincrement())
  nombre_animal        String       @db.VarChar(100)
  edad                 Int
  via_ingreso          String       @db.VarChar(100)
  peso_animal          Float
  especie_animal       String       @db.VarChar(100)
  sexo_animal          SexoAnimal
  observaciones_animal String?
  foto_animal          String?      @db.VarChar(255)
  // disponible, en_proceso (de adopción), adoptado o fallecido
  estado_animal        EstadoAnimal @default(disponible)

  historial   historial_medico[]
  adopciones  adopciones[]
  // galería de fotos del animal (foto_animal sigue siendo la portada)
  fotos       fotos_animal[]
  // solicitudes de adopción que se hicieron por este animal
  solicitudes solicitudes_adopcion[]
}

// Fotos de cada animal. Un animal puede tener varias (carrusel).
model fotos_animal {
  id_foto      Int      @id @default(autoincrement())
  ruta         String   @db.VarChar(255)
  fecha_subida DateTime @default(now())
  id_animal    Int
  // onDelete: Cascade → si se elimina el animal, se eliminan también sus filas de fotos
  animal       animales @relation(fields: [id_animal], references: [id_animal], onDelete: Cascade)
}

enum TipoDonacion {
  monetaria
  insumos
}

enum OrigenDonacion {
  presencial
  web
}

enum EstadoDonacion {
  pendiente
  agendada
  confirmada
  rechazada
}

enum MetodoPago {
  efectivo
  transferencia
}

model donaciones {
  id_donacion   Int            @id @default(autoincrement())
  tipo_donacion TipoDonacion
  origen        OrigenDonacion
  estado        EstadoDonacion

  monto_donacion      Int?
  metodo_pago         MetodoPago?
  comprobante_url     String?     @db.VarChar(255)
  descripcion_insumos String?     @db.VarChar(500)

  fecha_donacion     DateTime
  fecha_agendada     DateTime?
  fecha_confirmacion DateTime?

  donante_nombre   String? @db.VarChar(100)
  donante_correo   String? @db.VarChar(100)
  donante_telefono String? @db.VarChar(15)

  rut_usuario String?
  usuario     Usuario?              @relation(fields: [rut_usuario], references: [rut_usuario], onDelete: Restrict)
  id_cuenta   Int?
  cuenta      cuenta_transferencia? @relation(fields: [id_cuenta], references: [id_cuenta], onDelete: Restrict)

  insumos Insumo[]
}

model adoptante {
  id_adoptante            Int                    @id @default(autoincrement())
  // opcional en la base de datos porque los adoptantes antiguos no lo tenían; la API lo exige
  nombre_adoptante        String?                @db.VarChar(100)
  direccion               String
  telefono                String
  correo                  String
  fecha_nacimiento        DateTime
  observaciones_adoptante String?
  tipo_vivienda           TipoVivienda
  // nombre del PDF guardado en backend/uploads/certificados (solo los que postulan desde la página pública)
  certificado_antecedentes String?               @db.VarChar(255)
  adopciones              adopciones[]
  solicitudes             solicitudes_adopcion[]
}

// Solicitud de adopción: une a un adoptante con el animal que le interesa
// y guarda en qué parte del proceso va.
model solicitudes_adopcion {
  id_solicitud    Int             @id @default(autoincrement())
  fecha_solicitud DateTime        @default(now())
  estado          EstadoSolicitud @default(pendiente)
  // hora de la visita al refugio (se completa al agendarla)
  fecha_visita    DateTime?

  id_animal Int
  animal    animales @relation(fields: [id_animal], references: [id_animal])

  id_adoptante Int
  adoptante    adoptante @relation(fields: [id_adoptante], references: [id_adoptante])
}

enum TipoVivienda {
  casa
  departamento
}

enum SexoAnimal {
  macho
  hembra
}

// Estados de un animal
enum EstadoAnimal {
  disponible
  en_proceso
  adoptado
  fallecido
}

// Estados de una solicitud de adopción:
// pendiente (recién llegó), en_proceso (visita agendada o ingresada a mano), rechazada, adoptada
enum EstadoSolicitud {
  pendiente
  en_proceso
  rechazada
  adoptada
}

model adopciones {
  fecha_adopcion DateTime

  id_usuario String
  usuario    Usuario @relation(fields: [id_usuario], references: [rut_usuario])

  id_animal Int
  animal    animales @relation(fields: [id_animal], references: [id_animal])

  id_adoptante Int
  adoptante    adoptante @relation(fields: [id_adoptante], references: [id_adoptante])

  @@id([id_usuario, id_animal, id_adoptante])
}

enum TipoCuenta {
  corriente
  vista
  ahorro
  rut
}

model cuenta_transferencia {
  id_cuenta      Int        @id @default(autoincrement())
  banco          String     @db.VarChar(100)
  tipo_cuenta    TipoCuenta
  numero_cuenta  String     @db.VarChar(20)
  titular_nombre String     @db.VarChar(100)
  titular_rut    String     @db.VarChar(12)
  correo         String?    @db.VarChar(100)
  activa         Boolean    @default(true)

  // voluntario que administra la cuenta y confirma las donaciones que llegan a ella
  rut_usuario String
  usuario     Usuario @relation(fields: [rut_usuario], references: [rut_usuario], onDelete: Restrict)

  donaciones donaciones[]
}

model Rol {
  id       Int       @id
  nombre   String    @unique @db.VarChar(50)
  usuarios Usuario[]
}
